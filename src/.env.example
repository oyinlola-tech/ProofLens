PROOFLENS_APP_NAME=ProofLens
PROOFLENS_APP_VERSION=0.1.0
PROOFLENS_ENVIRONMENT=development
PROOFLENS_DEBUG=true

PROOFLENS_HOST=127.0.0.1
PROOFLENS_PORT=8000

PROOFLENS_API_PREFIX=/api/v1

PROOFLENS_DATABASE_URL=postgresql+asyncpg://betng:betng_local_dev@localhost:55432/prooflens
PROOFLENS_DATABASE_ECHO=false

# AI verification. Empty AI_PROVIDER picks the first provider with credentials
# (gemini, nvidia, groq); "ollama" needs no key; "none" runs deterministic checks only.
PROOFLENS_AI_PROVIDER=
PROOFLENS_AI_MODEL=
PROOFLENS_AI_TIMEOUT_SECONDS=30
PROOFLENS_AI_MAX_OUTPUT_TOKENS=2000
PROOFLENS_AI_REASONING_EFFORT=

PROOFLENS_GEMINI_API_KEY=
PROOFLENS_GEMINI_MODEL=gemini-3.8-flash
PROOFLENS_GEMINI_FALLBACK_MODELS=

PROOFLENS_NVIDIA_API_KEY=
PROOFLENS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PROOFLENS_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
PROOFLENS_NVIDIA_FALLBACK_MODELS=

PROOFLENS_GROQ_API_KEY=
PROOFLENS_GROQ_BASE_URL=https://api.groq.com/openai/v1
PROOFLENS_GROQ_MODEL=llama-3.3-70b-versatile
PROOFLENS_GROQ_FALLBACK_MODELS=

PROOFLENS_OLLAMA_BASE_URL=http://localhost:11434
PROOFLENS_OLLAMA_MODEL=llama3.1

PROOFLENS_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
PROOFLENS_CORS_ALLOW_CREDENTIALS=false
PROOFLENS_CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE"]
PROOFLENS_CORS_ALLOW_HEADERS=["Authorization","Content-Type"]

# Reverse proxies allowed to set X-Forwarded-For (JSON list of IPs)
PROOFLENS_TRUSTED_PROXY_IPS=[]

PROOFLENS_LOG_LEVEL=INFO

# Email verification. "console" prints emails to the server log (development only);
# "resend" uses the Resend API; "smtp" uses the SMTP settings below.
PROOFLENS_EMAIL_BACKEND=console
PROOFLENS_EMAIL_FROM=ProofLens <no-reply@localhost>
PROOFLENS_SUPPORT_EMAIL=support@prooflens.app
PROOFLENS_PUBLIC_WEB_URL=http://localhost:3000
PROOFLENS_RESEND_API_KEY=
PROOFLENS_OTP_LENGTH=6
PROOFLENS_OTP_EXPIRY_MINUTES=10
PROOFLENS_OTP_MAX_ATTEMPTS=5
PROOFLENS_OTP_RESEND_COOLDOWN_SECONDS=60
PROOFLENS_MAX_VERIFICATION_EMAILS_PER_HOUR=3
PROOFLENS_SMTP_HOST=localhost
PROOFLENS_SMTP_PORT=587
PROOFLENS_SMTP_USERNAME=
PROOFLENS_SMTP_PASSWORD=
PROOFLENS_SMTP_SECURITY=starttls

PROOFLENS_TEST_DATABASE_URL=postgresql+asyncpg://betng:betng_local_dev@localhost:55432/prooflens_test
